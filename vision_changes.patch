+SLOW_MIN_DUTY = 0.31        # a wheel that was driving keeps at least this while slowed (start duty 0.30)
+
+
+def slow_pwm(pwm, scale):
+    """Scale both wheels by ONE factor, so their ratio (= the curvature the CNN asked for)
+    is kept. The factor stops where the slower wheel would fall below the start duty; a
+    command whose slower wheel is already at or below it (tight corner) is left as it is.
+    Field 2026-11-14: clamping only the inner wheel turned [0.30, 0.49] into [0.31, 0.39]
+    in a corner, i.e. less turning, and the map lost the car there."""
+    p = np.asarray(pwm, float)
+    low = float(p.min())
+    if low < SLOW_MIN_DUTY:
+        return p
+    return p * max(scale, SLOW_MIN_DUTY / low)
 
 
